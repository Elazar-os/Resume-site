# References page passcode (required)
# Set this as a GitHub Actions secret named VITE_REFERENCES_PASSCODE.
VITE_REFERENCES_PASSCODE=your_passcode_here

# Gary providers — never commit real keys.
# Local: .dev.vars
# Production: Cloudflare Worker secrets (same names).
# Only GEMINI_API_KEY is required. The others are optional fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
