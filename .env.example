# References page passcode (required)
# Set this to the passcode visitors must enter to view reference contact details.
# In production, set this as a GitHub Actions secret named VITE_REFERENCES_PASSCODE.
VITE_REFERENCES_PASSCODE=your_passcode_here

# Gemini key for Gary (Worker secret — never commit the real value)
# Local: put this in .dev.vars
# Production: Cloudflare Worker secret + GitHub Actions secret named GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
